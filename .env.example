# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (used when deploying from GitHub without local firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Social Media OAuth Credentials (Optional — configure to enable server-side 3P OAuth)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_API_KEY=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Payment Gateway Indonesia (QRIS & Virtual Account)
# Supports Midtrans Core API or Xendit API. When omitted, runs in Sandbox Test Mode.
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""
PAYMENT_HMAC_SECRET=""
